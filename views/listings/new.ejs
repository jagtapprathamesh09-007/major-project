<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <!-- Form ko centered aur balanced width dene ke liye col-8 -->
  <div class="col-8 offset-2">
    <h3 class="mb-4">Create a New Listing</h3>
    
   <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
      
      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input 
          name="listing[title]" 
          placeholder="Add a catchy title" 
          type="text" 
          class="form-control" 
          id="title" 
          required 
        />
        <div class="invalid-feedback">please enter valid title</div>
      </div>
    

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea 
          name="listing[description]" 
          placeholder="enter description" 
          class="form-control" 
          id="description" 
          rows="4" 
          required
        ></textarea>
         <div class="invalid-feedback">please enter valid description</div>
      </div>

      <!-- Upload Image -->
<div class="mb-3">
  <label for="image" class="form-label">Upload Listing Image</label>
  <input 
    name="listing[image]" 
    type="file" 
    class="form-control" 
    id="image" 
    required
  />
  <div class="invalid-feedback">Please choose an image file</div>
</div>

      <!-- Price & Country (Side-by-Side Grid) -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input 
            name="listing[price]" 
            placeholder="1200" 
            type="number" 
            class="form-control" 
            id="price" 
            required 
          />
           <div class="invalid-feedback">please enter valid price</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input 
            name="listing[country]" 
            placeholder="India" 
            type="text" 
            class="form-control" 
            id="country" 
            required 
          />
           <div class="invalid-feedback">please enter valid country name</div>
        </div>
      </div>

      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input 
          name="listing[location]" 
          placeholder="Jaipur, Rajasthan" 
          type="text" 
          class="form-control" 
          id="location" 
          required 
        />
         <div class="invalid-feedback">please enter valid location</div>
      </div>

      <!-- Submit Button -->
      <button class="btn btn-dark add-btn mt-3">Add</button>
      
    </form>
  </div>
</div>