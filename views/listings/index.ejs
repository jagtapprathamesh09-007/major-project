<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <% if (AllListing.length === 0) { %>
    <div class="alert alert-danger col-6 offset-3 text-center mt-5 p-4 shadow-sm" role="alert">
      <i class="fa-solid fa-triangle-exclamation fs-1 text-danger mb-3"></i>
      <h4>No listings found!</h4>
      <p class="text-muted">We couldn't find any destination matching your search.</p>
      <a href="/listings" class="btn btn-dark mt-2">Explore all listings</a>
    </div>
  <% } else { %>
   
    
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
      <% for (let listing of AllListing) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="col">
            <div class="card h-100 listing-card">
              <img 
                src="<%= listing.image.url || listing.image %>" 
                class="card-img-top" 
                alt="listing_image" 
              />
              <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b><br />
                  &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                </p>
              </div>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>
</div>