<% layout("/layouts/boilerplate")%>
<body>
  <!-- FIX 2: Puri body content ko ek 'container' div me wrap kiya -->
  <div class="container mt-4">
    <h3 class="mb-3">All Listings</h3>
    
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
      <% for (listing of AllListing){ %>
       <a href="/listings/<%= listing._id%>" class="listing-link">
        <div class="col">
          <div class="card h-100">
            <img src="<%= listing.image.url || listing.image %>" class="card-img-top" alt="listing_image">
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b><br>
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
              </p>
            </div>
          </div>
        </div>
        </a>
      <% } %>
    </div>
  </div>
</body>
